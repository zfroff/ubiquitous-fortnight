{
  "name": "@fortnight/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && eslint src/web tests/web tests/e2e && prettier --check --ignore-path .prettierignore src/web tests/web tests/e2e",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config ../../tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/inter": "5.3.0",
    "@fortnight/shared": "*",
    "@fullcalendar/react": "7.1.4",
    "@tanstack/react-query": "5.80.7",
    "@tiptap/core": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "lucide-react": "1.72.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "temporal-polyfill": "1.0.8",
    "uuid": "14.0.3",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "26.1.0"
  }
}
